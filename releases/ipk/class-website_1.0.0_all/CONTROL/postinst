#!/bin/sh
# Post-install script for class-website

# Enable uhttpd
uci set uhttpd.main listen_http='0.0.0.0:8080'
uci set uhttpd.main home='/www/class-website'
uci commit uhttpd

# Restart uhttpd
/etc/init.d/uhttpd restart

echo "Class2C Portal installed successfully!"
echo "Access at: http://:8080"
