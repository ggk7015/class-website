#!/bin/sh
# Post-install script for class-website

# Create web directory
mkdir -p /www/class-website

# Copy files
cp -r /data/www/class-website/* /www/class-website/

# Configure uhttpd
uci set uhttpd.main.listen_http='0.0.0.0:8080'
uci set uhttpd.main.home='/www/class-website'
uci set uhttpd.main.index_page='index.html'
uci commit uhttpd

# Restart uhttpd
/etc/init.d/uhttpd restart

echo "Class2C Portal installed successfully!"
echo "Access at: http://$(uci get network.lan.ipaddr 2>/dev/null || echo 'router-ip'):8080"